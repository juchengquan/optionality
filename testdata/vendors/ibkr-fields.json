{
  "module": "ibkr-fields",
  "constants": {
    "ACCOUNT_TOTALS": {
      "NetLiquidation": "net_liquidation",
      "TotalCashValue": "total_cash",
      "UnrealizedPnL": "unrealized_pnl",
      "RealizedPnL": "realized_pnl"
    },
    "BASE": "BASE",
    "EXCHANGE_RATE": "$LEDGER-ExchangeRate",
    "GREEK_TICKS": {
      "$set": [
        13,
        83
      ]
    },
    "INDEX_FIGURES": [
      "last_price",
      "prev_close_price"
    ],
    "LEDGER": "$LEDGER-",
    "MARKET_DATA_DELAYED_FROZEN": 4,
    "MASK": "•••••",
    "PRICE_TICKS": {
      "1": "bid_price",
      "2": "ask_price",
      "4": "last_price",
      "9": "prev_close_price",
      "66": "bid_price",
      "67": "ask_price",
      "68": "last_price",
      "75": "prev_close_price"
    },
    "UNSET_DOUBLE": 1.7976931348623157e+308
  },
  "cases": [
    {
      "fn": "greekFields",
      "name": "implied volatility changes units, fraction into percent",
      "args": [
        {
          "impliedVol": 0.13679778548286392,
          "delta": null,
          "gamma": null,
          "vega": null,
          "theta": null
        }
      ],
      "expect": {
        "option_implied_volatility": 13.679778548286393
      }
    },
    {
      "fn": "greekFields",
      "name": "the greeks themselves are already dimensionless",
      "args": [
        {
          "impliedVol": null,
          "delta": 0.02806614063578037,
          "gamma": 0.00018826189971762677,
          "vega": 1.8321828845155324,
          "theta": -0.28028107934963487
        }
      ],
      "expect": {
        "option_delta": 0.02806614063578037,
        "option_gamma": 0.00018826189971762677,
        "option_vega": 1.8321828845155324,
        "option_theta": -0.28028107934963487
      }
    },
    {
      "fn": "greekFields",
      "name": "omits a greek that was not computed rather than writing null",
      "args": [
        {
          "impliedVol": null,
          "delta": null,
          "gamma": null,
          "vega": null,
          "theta": null
        }
      ],
      "expect": {}
    },
    {
      "fn": "grade",
      "name": "grade 1 is live and not frozen",
      "args": [
        1
      ],
      "expect": {
        "delayed": false,
        "last_known": false
      }
    },
    {
      "fn": "grade",
      "name": "grade 2 is live and last known",
      "args": [
        2
      ],
      "expect": {
        "delayed": false,
        "last_known": true
      }
    },
    {
      "fn": "grade",
      "name": "grade 3 is delayed",
      "args": [
        3
      ],
      "expect": {
        "delayed": true,
        "last_known": false
      }
    },
    {
      "fn": "grade",
      "name": "grade 4 is delayed AND last known, kept as both",
      "args": [
        4
      ],
      "expect": {
        "delayed": true,
        "last_known": true
      }
    },
    {
      "fn": "grade",
      "name": "says nothing about a grade nobody documented",
      "args": [
        0
      ],
      "expect": null
    },
    {
      "fn": "grade",
      "name": "and nothing about one out of range",
      "args": [
        7
      ],
      "expect": null
    },
    {
      "fn": "withMid",
      "name": "the midpoint where both sides arrived",
      "args": [
        {
          "bid_price": 3.5,
          "ask_price": 4.1,
          "mid_price": 3.8
        }
      ],
      "expect": {
        "bid_price": 3.5,
        "ask_price": 4.1,
        "mid_price": 3.8
      }
    },
    {
      "fn": "withMid",
      "name": "absent where only the bid did",
      "args": [
        {
          "bid_price": 3.5
        }
      ],
      "expect": {
        "bid_price": 3.5
      }
    },
    {
      "fn": "withMid",
      "name": "absent where only the ask did",
      "args": [
        {
          "ask_price": 4.1
        }
      ],
      "expect": {
        "ask_price": 4.1
      }
    },
    {
      "fn": "withMid",
      "name": "absent for an empty book, whose sides are kept",
      "args": [
        {
          "bid_price": 0,
          "ask_price": 0
        }
      ],
      "expect": {
        "bid_price": 0,
        "ask_price": 0
      }
    },
    {
      "fn": "withMid",
      "name": "absent where the ask is zero, whatever the bid",
      "args": [
        {
          "bid_price": 4.4,
          "ask_price": 0
        }
      ],
      "expect": {
        "bid_price": 4.4,
        "ask_price": 0
      }
    },
    {
      "fn": "withMid",
      "name": "a bid of zero against a real offer",
      "args": [
        {
          "bid_price": 0,
          "ask_price": 0.05,
          "mid_price": 0.025
        }
      ],
      "expect": {
        "bid_price": 0,
        "ask_price": 0.05,
        "mid_price": 0.025
      }
    },
    {
      "fn": "hasFigures",
      "name": "false for a record carrying only its identity",
      "args": [
        {
          "code": "SPX",
          "name": "S&P 500"
        }
      ],
      "expect": false
    },
    {
      "fn": "hasFigures",
      "name": "false for identity plus a grade, which is not a figure",
      "args": [
        {
          "code": "SPX",
          "delayed": true,
          "last_known": true
        }
      ],
      "expect": false
    },
    {
      "fn": "hasFigures",
      "name": "true for one figure, however little",
      "args": [
        {
          "code": "SPX",
          "prev_close_price": 7353.73
        }
      ],
      "expect": true
    },
    {
      "fn": "managedAccounts",
      "name": "a single account",
      "args": [
        "U0000000"
      ],
      "expect": [
        "U0000000"
      ]
    },
    {
      "fn": "managedAccounts",
      "name": "several, comma-separated",
      "args": [
        "U0000000,U0000001"
      ],
      "expect": [
        "U0000000",
        "U0000001"
      ]
    },
    {
      "fn": "managedAccounts",
      "name": "a trailing comma names no account",
      "args": [
        "DU0000000,"
      ],
      "expect": [
        "DU0000000"
      ]
    },
    {
      "fn": "managedAccounts",
      "name": "an empty field names none",
      "args": [
        ""
      ],
      "expect": []
    },
    {
      "fn": "managedAccounts",
      "name": "trimmed as JavaScript trims: a BOM goes, a \\x1c stays",
      "args": [
        "﻿U0000000,U0000001\u001c"
      ],
      "expect": [
        "U0000000",
        "U0000001\u001c"
      ]
    },
    {
      "fn": "maskAccount",
      "name": "the prefix, five bullets, the last three",
      "args": [
        "U0000001"
      ],
      "expect": "U•••••001"
    },
    {
      "fn": "maskAccount",
      "name": "five bullets for a longer id too",
      "args": [
        "U00000001"
      ],
      "expect": "U•••••001"
    },
    {
      "fn": "maskAccount",
      "name": "a paper id keeps its DU",
      "args": [
        "DU0000000"
      ],
      "expect": "DU•••••000"
    },
    {
      "fn": "maskAccount",
      "name": "a digit after the prefix's last letter is masked like the rest",
      "args": [
        "DU00A0001"
      ],
      "expect": "DU•••••001"
    },
    {
      "fn": "maskAccount",
      "name": "a short id shows all but one of its digits, never all",
      "args": [
        "U001"
      ],
      "expect": "U•••••01"
    },
    {
      "fn": "maskAccount",
      "name": "a one-digit id shows no digit",
      "args": [
        "U1"
      ],
      "expect": "U•••••"
    },
    {
      "fn": "maskAccount",
      "name": "an id of letters alone keeps no prefix, only its last three",
      "args": [
        "ABCDEFG"
      ],
      "expect": "•••••EFG"
    },
    {
      "fn": "maskAccount",
      "name": "an empty id is the five bullets alone",
      "args": [
        ""
      ],
      "expect": "•••••"
    },
    {
      "fn": "isPaper",
      "name": "an id that starts DU is paper",
      "args": [
        "DU0000000"
      ],
      "expect": true
    },
    {
      "fn": "isPaper",
      "name": "a live individual account is not",
      "args": [
        "U0000000"
      ],
      "expect": false
    },
    {
      "fn": "isPaper",
      "name": "nor is an advisor's DF",
      "args": [
        "DF0000000"
      ],
      "expect": false
    },
    {
      "fn": "chooseAccount",
      "name": "the login's only account, unasked",
      "args": [
        [
          "U0000000"
        ],
        null
      ],
      "expect": {
        "account": "U0000000"
      }
    },
    {
      "fn": "chooseAccount",
      "name": "the one named, of several",
      "args": [
        [
          "U0000000",
          "U0000001"
        ],
        "U0000001"
      ],
      "expect": {
        "account": "U0000001"
      }
    },
    {
      "fn": "chooseAccount",
      "name": "several and none named: refused, the ids masked",
      "args": [
        [
          "U0000000",
          "U0000001"
        ],
        null
      ],
      "expect": {
        "refused": "several accounts on this login; set IBKR_ACCOUNT to one of U•••••000, U•••••001"
      }
    },
    {
      "fn": "chooseAccount",
      "name": "a named account not on the login: refused, it masked too",
      "args": [
        [
          "U0000000",
          "U0000001"
        ],
        "DU0000001"
      ],
      "expect": {
        "refused": "IBKR_ACCOUNT (DU•••••001) names no account on this login, which has U•••••000, U•••••001"
      }
    },
    {
      "fn": "chooseAccount",
      "name": "named, even with a single account, it must be that one",
      "args": [
        [
          "U0000000"
        ],
        "U0000001"
      ],
      "expect": {
        "refused": "IBKR_ACCOUNT (U•••••001) names no account on this login, which has U•••••000"
      }
    },
    {
      "fn": "chooseAccount",
      "name": "a blank name is none",
      "args": [
        [
          "U0000000"
        ],
        " "
      ],
      "expect": {
        "account": "U0000000"
      }
    },
    {
      "fn": "chooseAccount",
      "name": "a name led by a BOM is the name",
      "args": [
        [
          "U0000000",
          "U0000001"
        ],
        "﻿U0000001"
      ],
      "expect": {
        "account": "U0000001"
      }
    },
    {
      "fn": "chooseAccount",
      "name": "a name led by a \\x1c names no account",
      "args": [
        [
          "U0000000",
          "U0000001"
        ],
        "\u001cU0000001"
      ],
      "expect": {
        "refused": "IBKR_ACCOUNT (•••••001) names no account on this login, which has U•••••000, U•••••001"
      }
    },
    {
      "fn": "chooseAccount",
      "name": "no account named by the gateway",
      "args": [
        [],
        null
      ],
      "expect": {
        "refused": "IB Gateway named no account on this login"
      }
    },
