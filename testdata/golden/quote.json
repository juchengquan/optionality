{
  "module": "quote",
  "constants": {},
  "cases": [
    {
      "fn": "displayRecords",
      "name": "the last trade is converted and the fetch is stamped",
      "args": [
        [
          {
            "code": "US.SPXW261120C7100000",
            "mid_price": 5.1,
            "update_time": "2026-11-19 09:47:23"
          }
        ],
        "Asia/Singapore",
        {
          "$date": "2026-11-19T13:47:30.000Z"
        }
      ],
      "expect": {
        "US.SPXW261120C7100000": {
          "code": "US.SPXW261120C7100000",
          "mid_price": 5.1,
          "update_time": "2026-11-19 22:47:23+08:00",
          "fetched_at": "2026-11-19 21:47:30+08:00"
        }
      }
    },
    {
      "fn": "displayRecords",
      "name": "a record with no last trade is still stamped",
      "args": [
        [
          {
            "code": "US.SPXW261120C7100000",
            "mid_price": 5.1
          }
        ],
        "Asia/Singapore",
        {
          "$date": "2026-11-19T13:47:30.000Z"
        }
      ],
      "expect": {
        "US.SPXW261120C7100000": {
          "code": "US.SPXW261120C7100000",
          "mid_price": 5.1,
          "fetched_at": "2026-11-19 21:47:30+08:00"
        }
      }
    },
    {
      "fn": "displayRecords",
      "name": "several records, keyed by code",
      "args": [
        [
          {
            "code": "A",
            "mid_price": 1
          },
          {
            "code": "B",
            "mid_price": 2
          }
        ],
        "America/New_York",
        {
          "$date": "2026-11-19T13:47:30.000Z"
        }
      ],
      "expect": {
        "A": {
          "code": "A",
          "mid_price": 1,
          "fetched_at": "2026-11-19 08:47:30-05:00"
        },
        "B": {
          "code": "B",
          "mid_price": 2,
          "fetched_at": "2026-11-19 08:47:30-05:00"
        }
      }
    },
    {
      "fn": "displayRecords",
