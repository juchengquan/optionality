{
  "module": "quote",
  "constants": {},
  "cases": [
    {
      "fn": "displayRecords",
      "name": "the last trade is converted and the fetch is stamped",
      "args": [
        [
          {
            "code": "US.SPXW261120C7100000",
            "mid_price": 5.1,
            "update_time": "2026-11-19 09:47:23"
          }
        ],
        "Asia/Singapore",
        {
          "$date": "2026-11-19T13:47:30.000Z"
        }
      ],
      "expect": {
        "US.SPXW261120C7100000": {
          "code": "US.SPXW261120C7100000",
          "mid_price": 5.1,
          "update_time": "2026-11-19 22:47:23+08:00",
          "fetched_at": "2026-11-19 21:47:30+08:00"
        }
      }
    },
    {
      "fn": "displayRecords",
      "name": "a record with no last trade is still stamped",
      "args": [
        [
          {
            "code": "US.SPXW261120C7100000",
            "mid_price": 5.1
          }
        ],
        "Asia/Singapore",
        {
          "$date": "2026-11-19T13:47:30.000Z"
        }
      ],
      "expect": {
        "US.SPXW261120C7100000": {
          "code": "US.SPXW261120C7100000",
          "mid_price": 5.1,
          "fetched_at": "2026-11-19 21:47:30+08:00"
        }
      }
    },
    {
      "fn": "displayRecords",
      "name": "several records, keyed by code",
      "args": [
        [
          {
            "code": "A",
            "mid_price": 1
          },
          {
            "code": "B",
            "mid_price": 2
          }
        ],
        "America/New_York",
        {
          "$date": "2026-11-19T13:47:30.000Z"
        }
      ],
      "expect": {
        "A": {
          "code": "A",
          "mid_price": 1,
          "fetched_at": "2026-11-19 08:47:30-05:00"
        },
        "B": {
          "code": "B",
          "mid_price": 2,
          "fetched_at": "2026-11-19 08:47:30-05:00"
        }
      }
    },
    {
      "fn": "displayRecords",
      "name": "no fetch time at all",
      "args": [
        [
          {
            "code": "A",
            "mid_price": 1
          }
        ],
        "Asia/Singapore",
        null
      ],
      "expect": {
        "A": {
          "code": "A",
          "mid_price": 1,
          "fetched_at": null
        }
      }
    },
    {
      "fn": "displayRecords",
      "name": "nothing came back",
      "args": [
        [],
        "Asia/Singapore",
        {
          "$date": "2026-11-19T13:47:30.000Z"
        }
      ],
      "expect": {}
    },
    {
      "fn": "verifyVerdict",
      "name": "every code priced, so nothing is wrong",
      "args": [
        [
          "A",
          "B"
        ],
        {
          "records": [
            {
              "code": "A"
            },
            {
              "code": "B"
            }
          ],
          "unknown": []
        }
      ],
      "expect": null
    },
    {
      "fn": "verifyVerdict",
      "name": "a code the provider does not know",
      "args": [
        [
          "A",
          "B"
        ],
        {
          "records": [
            {
              "code": "A"
            }
          ],
          "unknown": [
            "B"
          ]
        }
      ],
      "expect": "contract does not exist: B — check strike and expiry"
    },
    {
      "fn": "verifyVerdict",
      "name": "two unknown codes, named in the order asked",
      "args": [
        [
          "A",
          "B"
        ],
        {
          "records": [],
          "unknown": [
            "A",
            "B"
          ]
        }
      ],
      "expect": "contract does not exist: A, B — check strike and expiry"
    },
    {
      "fn": "verifyVerdict",
      "name": "silently missing counts as not existing",
      "args": [
        [
          "A",
          "B"
        ],
        {
          "records": [
            {
              "code": "A"
            }
          ],
          "unknown": []
        }
      ],
      "expect": "contract does not exist: B — check strike and expiry"
    },
    {
      "fn": "verifyVerdict",
      "name": "unknown wins over missing when both apply",
      "args": [
        [
          "A",
          "B"
        ],
        {
          "records": [],
          "unknown": [
            "B"
          ]
        }
      ],
      "expect": "contract does not exist: B — check strike and expiry"
    },
    {
      "fn": "verifyVerdict",
      "name": "nothing asked for is nothing wrong",
      "args": [
        [],
        {
          "records": [],
          "unknown": []
        }
      ],
      "expect": null
    },
    {
      "fn": "derivedSpx",
      "name": "a call: (strike + last) / (1 + premium)",
      "args": [
        [
          {
            "code": "US.SPXW261113C7475000",
            "last_price": 79.2,
            "option_premium": 0.547
          }
        ]
      ],
      "expect": {
        "price": 7513.1,
        "reason": null
      }
    },
    {
      "fn": "derivedSpx",
      "name": "a put: (strike - last) / (1 - premium)",
      "args": [
        [
          {
            "code": "US.SPXW261218P7525000",
            "last_price": 160.24,
            "option_premium": 2
          }
        ]
      ],
      "expect": {
        "price": 7515.06,
        "reason": null
      }
    },
    {
      "fn": "derivedSpx",
      "name": "a negative premium is taken as it comes",
      "args": [
        [
          {
            "code": "US.SPXW261113P7625000",
            "last_price": 111.9,
            "option_premium": -0.266
          }
        ]
      ],
      "expect": {
        "price": 7493.17,
        "reason": null
      }
    },
    {
      "fn": "derivedSpx",
      "name": "the median of three, in any order",
      "args": [
        [
          {
            "code": "US.SPXW261218P7525000",
            "last_price": 160.24,
            "option_premium": 2
          },
          {
            "code": "US.SPXW261204C7500000",
            "last_price": 120,
            "option_premium": 1.5
          },
          {
            "code": "US.SPXW261113C7475000",
            "last_price": 79.2,
            "option_premium": 0.547
          }
        ]
      ],
      "expect": {
        "price": 7513.1,
        "reason": null
      }
    },
    {
      "fn": "derivedSpx",
      "name": "two: the middle pair averaged before rounding",
      "args": [
        [
          {
            "code": "US.SPXW261113C7475000",
            "last_price": 79.2,
            "option_premium": 0.547
          },
          {
            "code": "US.SPXW261218P7525000",
            "last_price": 160.24,
            "option_premium": 2
          }
        ]
      ],
      "expect": {
        "price": 7514.08,
        "reason": null
      }
    },
    {
      "fn": "derivedSpx",
      "name": "a stale last stays in",
      "args": [
        [
          {
            "code": "US.SPXW261113C7475000",
            "last_price": 79.2,
            "option_premium": 0.547,
            "update_time": "2026-11-09 20:15:00"
          }
        ]
      ],
      "expect": {
        "price": 7513.1,
        "reason": null
      }
    },
    {
      "fn": "derivedSpx",
      "name": "the mid is never inverted",
      "args": [
        [
          {
            "code": "US.SPXW261113C7475000",
            "last_price": 79.2,
            "option_premium": 0.547,
            "mid_price": 81.4
          }
        ]
      ],
      "expect": {
        "price": 7513.1,
        "reason": null
      }
    },
    {
      "fn": "derivedSpx",
      "name": "what cannot be inverted is left out",
      "args": [
        [
          {
            "code": "US.SPXW261113C7475000",
            "last_price": 79.2,
            "option_premium": 0.547
          },
          {
            "code": "US..SPX",
            "last_price": 7600,
            "option_premium": 0
          },
          {
            "code": "US.SPXW261113C7500000",
            "last_price": 60
          },
          {
            "code": "US.SPXW261113C7575000",
            "last_price": 0,
            "option_premium": 0.9
          },
          {
            "code": "US.SPXW261113C7600000",
            "last_price": "12.5",
            "option_premium": 0.9
          },
          {
            "code": "US.SPXW261113C7625000",
            "last_price": 10,
            "option_premium": true
          },
          {
            "code": "US.SPXW261113P7500000",
            "last_price": 10,
            "option_premium": 100
          }
        ]
      ],
      "expect": {
        "price": 7513.1,
        "reason": null
      }
    },
    {
      "fn": "derivedSpx",
      "name": "no SPX option in the batch",
      "args": [
        []
      ],
      "expect": {
        "price": null,
        "reason": "no SPX option in the batch to derive it from"
      }
    },
    {
      "fn": "derivedSpx",
      "name": "a code that is not a string is no option",
      "args": [
        [
          {
            "code": [
              "US.SPXW261113C7475000"
            ],
            "last_price": 79.2,
            "option_premium": 0.547
          }
        ]
      ],
      "expect": {
        "price": null,
        "reason": "no SPX option in the batch to derive it from"
      }
    },
    {
      "fn": "derivedSpx",
      "name": "a missing premium",
      "args": [
        [
          {
            "code": "US.SPXW261113C7475000",
            "last_price": 79.2
          },
          {
            "code": "US.SPXW261218P7525000",
            "last_price": 160.24,
            "option_premium": null
          }
        ]
      ],
      "expect": {
        "price": null,
        "reason": "the Provider gives no option premium to derive it from"
      }
    },
    {
      "fn": "derivedSpx",
      "name": "a premium with no last trade",
      "args": [
        [
          {
            "code": "US.SPXW261113C7475000",
            "last_price": null,
            "option_premium": 0.547
          }
        ]
      ],
      "expect": {
        "price": null,
        "reason": "no option in the batch has both a last trade and a premium"
      }
    },
    {
      "fn": "round4",
      "name": "four places",
      "args": [
        1.23456
      ],
      "expect": 1.2346
    },
    {
      "fn": "round4",
      "name": "a decimal half that is not one in binary",
      "args": [
        1.00005
      ],
      "expect": 1.0001
    },
    {
      "fn": "round4",
      "name": "2.675",
      "args": [
        2.675
      ],
      "expect": 2.675
    },
    {
      "fn": "round4",
      "name": "negative",
      "args": [
        -0.12345
      ],
      "expect": -0.1235
    },
    {
      "fn": "round4",
      "name": "float noise",
      "args": [
        0.30000000000000004
      ],
      "expect": 0.3
    },
    {
      "fn": "round4",
      "name": "an exact binary half rounds up",
      "args": [
        0.03125
      ],
      "expect": 0.0313
    },
    {
      "fn": "round4",
      "name": "an exact binary half, negative, rounds away from zero",
      "args": [
        -0.03125
      ],
      "expect": -0.0313
    },
    {
      "fn": "unverifiableVerdict",
      "name": "a dropped connection speaks in errno",
      "args": [
        "snapshot API failed: connect ECONNREFUSED 127.0.0.1:11111"
      ],
      "expect": "cannot verify contract: the Provider did not confirm it — snapshot API failed: connect ECONNREFUSED 127.0.0.1:11111"
    },
    {
      "fn": "unverifiableVerdict",
      "name": "a Provider that answered and declined the security",
      "args": [
        "snapshot API failed: US stock indices are not supported"
      ],
      "expect": "cannot verify contract: the Provider did not confirm it — snapshot API failed: US stock indices are not supported"
    },
    {
      "fn": "unverifiableVerdict",
      "name": "a Provider that said nothing at all",
      "args": [
        ""
      ],
      "expect": "cannot verify contract: the Provider did not confirm it — "
    }
  ]
}
