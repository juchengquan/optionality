{
  "module": "quote",
  "constants": {},
  "cases": [
    {
      "fn": "displayRecords",
      "name": "the last trade is converted and the fetch is stamped",
      "args": [
        [
          {
            "code": "US.SPXW261120C7100000",
            "mid_price": 5.1,
            "update_time": "2026-11-19 09:47:23"
          }
        ],
        "Asia/Singapore",
        {
          "$date": "2026-11-19T13:47:30.000Z"
        }
      ],
      "expect": {
        "US.SPXW261120C7100000": {
          "code": "US.SPXW261120C7100000",
          "mid_price": 5.1,
          "update_time": "2026-11-19 22:47:23+08:00",
          "fetched_at": "2026-11-19 21:47:30+08:00"
        }
      }
    },
    {
      "fn": "displayRecords",
      "name": "a record with no last trade is still stamped",
      "args": [
        [
          {
            "code": "US.SPXW261120C7100000",
            "mid_price": 5.1
          }
        ],
        "Asia/Singapore",
        {
          "$date": "2026-11-19T13:47:30.000Z"
        }
      ],
      "expect": {
        "US.SPXW261120C7100000": {
          "code": "US.SPXW261120C7100000",
          "mid_price": 5.1,
          "fetched_at": "2026-11-19 21:47:30+08:00"
        }
      }
    },
    {
      "fn": "displayRecords",
      "name": "several records, keyed by code",
      "args": [
        [
          {
            "code": "A",
            "mid_price": 1
          },
          {
            "code": "B",
            "mid_price": 2
          }
        ],
        "America/New_York",
        {
          "$date": "2026-11-19T13:47:30.000Z"
        }
      ],
      "expect": {
        "A": {
          "code": "A",
          "mid_price": 1,
          "fetched_at": "2026-11-19 08:47:30-05:00"
        },
        "B": {
          "code": "B",
          "mid_price": 2,
          "fetched_at": "2026-11-19 08:47:30-05:00"
        }
      }
    },
    {
      "fn": "displayRecords",
      "name": "no fetch time at all",
      "args": [
        [
          {
            "code": "A",
            "mid_price": 1
          }
        ],
        "Asia/Singapore",
        null
      ],
      "expect": {
        "A": {
          "code": "A",
          "mid_price": 1,
          "fetched_at": null
        }
      }
    },
    {
      "fn": "displayRecords",
      "name": "nothing came back",
      "args": [
        [],
        "Asia/Singapore",
        {
          "$date": "2026-11-19T13:47:30.000Z"
        }
      ],
      "expect": {}
    },
    {
      "fn": "verifyVerdict",
      "name": "every code priced, so nothing is wrong",
      "args": [
        [
          "A",
          "B"
        ],
        {
          "records": [
            {
              "code": "A"
            },
            {
              "code": "B"
            }
          ],
          "unknown": []
        }
      ],
      "expect": null
    },
    {
      "fn": "verifyVerdict",
      "name": "a code the provider does not know",
      "args": [
        [
          "A",
          "B"
        ],
        {
          "records": [
            {
              "code": "A"
            }
          ],
          "unknown": [
            "B"
          ]
        }
      ],
      "expect": "contract does not exist: B — check strike and expiry"
    },
    {
      "fn": "verifyVerdict",
      "name": "two unknown codes, named in the order asked",
      "args": [
        [
          "A",
          "B"
        ],
        {
          "records": [],
          "unknown": [
            "A",
            "B"
          ]
        }
      ],
      "expect": "contract does not exist: A, B — check strike and expiry"
    },
    {
      "fn": "verifyVerdict",
      "name": "silently missing counts as not existing",
      "args": [
        [
          "A",
          "B"
        ],
        {
          "records": [
            {
              "code": "A"
            }
          ],
          "unknown": []
        }
      ],
      "expect": "contract does not exist: B — check strike and expiry"
    },
    {
      "fn": "verifyVerdict",
      "name": "unknown wins over missing when both apply",
      "args": [
        [
          "A",
          "B"
        ],
        {
          "records": [],
          "unknown": [
            "B"
          ]
        }
      ],
      "expect": "contract does not exist: B — check strike and expiry"
    },
    {
      "fn": "verifyVerdict",
      "name": "nothing asked for is nothing wrong",
      "args": [
        [],
        {
          "records": [],
          "unknown": []
        }
      ],
      "expect": null
    },
    {
      "fn": "round4",
      "name": "four places",
      "args": [
        1.23456
      ],
      "expect": 1.2346
    },
    {
      "fn": "round4",
      "name": "a decimal half that is not one in binary",
      "args": [
        1.00005
      ],
      "expect": 1.0001
    },
    {
      "fn": "round4",
      "name": "2.675",
      "args": [
        2.675
      ],
      "expect": 2.675
    },
    {
      "fn": "round4",
      "name": "negative",
      "args": [
        -0.12345
      ],
      "expect": -0.1235
    },
    {
      "fn": "round4",
      "name": "float noise",
      "args": [
        0.30000000000000004
      ],
      "expect": 0.3
    },
    {
      "fn": "round4",
      "name": "an exact binary half rounds up",
      "args": [
        0.03125
      ],
      "expect": 0.0313
    },
    {
      "fn": "round4",
      "name": "an exact binary half, negative, rounds away from zero",
      "args": [
        -0.03125
      ],
      "expect": -0.0313
    },
    {
      "fn": "unverifiableVerdict",
      "name": "a dropped connection speaks in errno",
      "args": [
        "snapshot API failed: connect ECONNREFUSED 127.0.0.1:11111"
      ],
      "expect": "cannot verify contract: the Provider did not confirm it — snapshot API failed: connect ECONNREFUSED 127.0.0.1:11111"
    },
    {
      "fn": "unverifiableVerdict",
      "name": "a Provider that answered and declined the security",
      "args": [
        "snapshot API failed: US stock indices are not supported"
      ],
      "expect": "cannot verify contract: the Provider did not confirm it — snapshot API failed: US stock indices are not supported"
    },
    {
      "fn": "unverifiableVerdict",
      "name": "a Provider that said nothing at all",
      "args": [
        ""
      ],
      "expect": "cannot verify contract: the Provider did not confirm it — "
    }
  ]
}
