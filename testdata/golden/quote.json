      "args": [
        [
          {
            "code": "A",
            "mid_price": 1
          }
        ],
        "Asia/Singapore",
        null
      ],
      "expect": {
        "A": {
          "code": "A",
          "mid_price": 1,
          "fetched_at": null
        }
      }
    },
    {
      "fn": "displayRecords",
