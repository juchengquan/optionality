{
  "module": "timefmt",
  "cases": [
    {
      "fn": "displayTime",
      "name": "in Singapore",
      "args": [
        {
          "$date": "2026-10-17T05:26:06.000Z"
        },
        "Asia/Singapore"
      ],
      "expect": "2026-10-17 13:26:06+08:00"
    },
    {
      "fn": "displayTime",
      "name": "in New York, daylight time",
      "args": [
        {
          "$date": "2026-10-17T05:26:06.000Z"
        },
        "America/New_York"
      ],
      "expect": "2026-10-17 01:26:06-04:00"
    },
    {
      "fn": "displayTime",
      "name": "in New York, standard time",
      "args": [
        {
          "$date": "2026-11-17T05:26:06.000Z"
        },
        "America/New_York"
      ],
      "expect": "2026-11-17 00:26:06-05:00"
    },
    {
      "fn": "displayTime",
      "name": "in UTC",
      "args": [
        {
          "$date": "2026-10-17T05:26:06.000Z"
        },
        "UTC"
      ],
      "expect": "2026-10-17 05:26:06+00:00"
    },
    {
      "fn": "displayTime",
      "name": "nothing to show",
      "args": [
        null,
        "Asia/Singapore"
      ],
      "expect": null
    },
    {
      "fn": "displayTimeShort",
      "name": "short, in Singapore",
      "args": [
        {
          "$date": "2026-10-17T05:26:06.000Z"
        },
        "Asia/Singapore"
      ],
      "expect": "2026-10-17 13:26 +08"
    },
    {
      "fn": "displayTimeShort",
      "name": "short, in New York, standard time",
      "args": [
        {
          "$date": "2026-01-15T12:00:00.000Z"
        },
        "America/New_York"
      ],
      "expect": "2026-01-15 07:00 EST"
    },
    {
      "fn": "displayTimeShort",
      "name": "short, in New York, daylight time",
      "args": [
        {
          "$date": "2026-07-15T12:00:00.000Z"
        },
        "America/New_York"
      ],
      "expect": "2026-07-15 08:00 EDT"
    },
    {
      "fn": "displayTimeShort",
      "name": "short, in UTC",
      "args": [
        {
          "$date": "2026-01-15T12:00:00.000Z"
        },
        "UTC"
      ],
      "expect": "2026-01-15 12:00 UTC"
    },
    {
      "fn": "displayTimeShort",
      "name": "short, on a three-quarter-hour offset",
      "args": [
        {
          "$date": "2026-01-15T12:00:00.000Z"
        },
        "Asia/Kathmandu"
      ],
      "expect": "2026-01-15 17:45 +0545"
    },
    {
      "fn": "displayTimeShort",
      "name": "short, in London, where only winter agrees",
      "args": [
        {
          "$date": "2026-01-15T12:00:00.000Z"
        },
        "Europe/London"
      ],
      "expect": "2026-01-15 12:00 GMT"
    },
    {
      "fn": "displayTimeShort",
      "name": "short, nothing to show",
      "args": [
        null,
        "Asia/Singapore"
      ],
      "expect": null
    },
    {
      "fn": "marketTimeToDisplay",
      "name": "moomoo's naive Eastern time",
      "args": [
        "2026-10-16 15:59:58",
        "Asia/Singapore"
      ],
      "expect": "2026-10-17 03:59:58+08:00"
    },
    {
      "fn": "marketTimeToDisplay",
      "name": "with a fraction",
      "args": [
        "2026-10-16 15:59:58.125",
        "Asia/Singapore"
      ],
      "expect": "2026-10-17 03:59:58+08:00"
    },
    {
      "fn": "marketTimeToDisplay",
      "name": "the hour that happens twice",
      "args": [
        "2026-11-01 01:30:00",
        "UTC"
      ],
      "expect": "2026-11-01 05:30:00+00:00"
    },
    {
      "fn": "marketTimeToDisplay",
      "name": "not a time comes back untouched",
      "args": [
        "N/A",
        "Asia/Singapore"
      ],
      "expect": "N/A"
    },
    {
      "fn": "marketTimeToDisplay",
      "name": "an impossible time comes back untouched",
      "args": [
        "2026-13-45 99:99:99",
        "UTC"
      ],
      "expect": "2026-13-45 99:99:99"
    }
  ]
}
