# The service's database. Commented out because the default is already right; the launchd plist
# sets it too. Never point this at data/optionality.db — that is the retired Python's, frozen at
# the cutover, and the service migrates whatever it opens.
# OPTIONALITY_DB_PATH=data/optionality-ts.db

# Where market data comes from. One Provider per deployment, read once at boot (ADR 0015): the
# dashboard, the alarms and the figures are identical whichever it is, and /health reports which
# one answered. A name the build does not know is fatal rather than a quiet fallback.
# Known: moomoo.
# OPTIONALITY_PROVIDER=moomoo

# API auth token required in the Authorization: Bearer header (generate: openssl rand -hex 24)
API_TOKEN=

# Telegram bot for monitor alarms (token from @BotFather; chat id via getUpdates — see README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Seconds between monitor sweeps (one snapshot API call per sweep regardless of watchlist size)
MONITOR_INTERVAL_SECONDS=60

# The two alarm cadences answer different questions:
#   COOLDOWN — how fast may a monitor speak when its state is CHANGING (⚠️ breach / ✅ recovery edges).
#     Flap protection: a value oscillating right at the threshold flips the 🔔 every sweep, and
#     without this gap it would message on every flip. The 🔔 itself always flips truthfully.
#   REPEAT — how often should a monitor speak when its state is NOT changing (breach persists).
#     Re-sends "still ≥/≤ threshold (reminder)" so a sustained breach can't be missed once and forgotten.
# Neither replaces the other: cooldown=0 lets flapping spam regardless of repeat; repeat=0 makes a
# steady breach silent after one alarm regardless of cooldown. Equal values give uniform pacing:
# every message from a monitor arrives at least that many seconds after its previous one.
ALARM_COOLDOWN_SECONDS=120
ALARM_REPEAT_SECONDS=1800   # 0 disables reminders

# Dashboard live-region poll interval (seconds)
UI_REFRESH_SECONDS=30

# Consecutive sweep failures before the "monitoring degraded" telegram alert
DEGRADED_AFTER_FAILURES=5

# Consecutive sweeps a monitor's watched figure may fail to arrive for before the rule is
# quarantined: disabled with a telegram notice, never deleted, unmutable from the dashboard.
# A figure that is not served — an entitlement you do not have, a leg that stops being priced —
# otherwise leaves an alarm that cannot fire looking exactly like one that is not breached.
# 0 = never quarantine, only log, which is what the engine did before.
QUARANTINE_AFTER_SILENT_SWEEPS=10

# Expired monitors are muted (with a telegram notice) on expiry, then auto-deleted this many
# days later; 0 = delete immediately on expiry. Nothing else is ever auto-deleted.
EXPIRED_RETENTION_DAYS=7
# The exit schedule (ADR 0011), which applies to every Position rather than being set per trade.
#   TAKE     — fraction of Entry taken as profit. Fractional, unlike every other knob here.
#              Worth knowing: decay ALONE reaches 50% of a 45-DTE credit only around 11 DTE, so
#              hitting this target at 21 DTE came from an IV drop or a move, not from waiting.
#   STOP     — Cost to close, as a multiple of Entry, that ends the trade. Also fractional.
#   MANAGE   — a DEADLINE, not a level: one telegram notice when a Position reaches this DTE,
#              whatever its P&L, because past here the risk of holding stops being paid for.
#              A whole number of days. Only Positions whose `opened_at` has been declared get it.
# Target and Stop apply to credit structures only — a fraction of Entry is the credit you keep,
# and a debit has none. The on-pace reference works for both and never raises an alarm.
EXIT_TAKE_FRACTION=0.5
EXIT_STOP_MULTIPLE=2.0
EXIT_MANAGE_BY_DTE=21

# URL prefix when serving behind a path-stripping reverse proxy. This must be the path the
# API itself answers on, NOT the one the dashboard uses: since ADR 0006 they are different
# services, so /opt is Caddy and the API lives at /opt/api. Getting this wrong is quiet --
# everything works except /docs, which then aims "Try it out" at the dashboard.
# Leave empty for direct access. Note: with this set, open /docs via the proxy URL, not localhost.
ROOT_PATH=

# Timezone for all displayed timestamps (DB records shown in API/bot, plus market update_time,
# which moomoo delivers in US Eastern). Empty = host timezone. Storage stays UTC either way.
DISPLAY_TZ=

# Where the service reaches OpenD. Leave unset for 127.0.0.1, which is right for launchd and
# make serve alike.
# OPEND_HOST=127.0.0.1
