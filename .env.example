# API auth token required in the Authorization: Bearer header (generate: openssl rand -hex 24)
API_TOKEN=

# Gmail app password credentials (https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# healthchecks.io ping URL for the dead-man's switch (optional but recommended)
HEALTHCHECK_URL=

# Telegram bot for monitor alarms (token from @BotFather; chat id via getUpdates — see README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Seconds between monitor sweeps (one snapshot API call per sweep regardless of watchlist size)
MONITOR_INTERVAL_SECONDS=60

# The two alarm cadences answer different questions:
#   COOLDOWN — how fast may a monitor speak when its state is CHANGING (⚠️ breach / ✅ recovery edges).
#     Flap protection: a value oscillating right at the threshold flips the 🔔 every sweep, and
#     without this gap it would message on every flip. The 🔔 itself always flips truthfully.
#   REPEAT — how often should a monitor speak when its state is NOT changing (breach persists).
#     Re-sends "still ≥/≤ threshold (reminder)" so a sustained breach can't be missed once and forgotten.
# Neither replaces the other: cooldown=0 lets flapping spam regardless of repeat; repeat=0 makes a
# steady breach silent after one alarm regardless of cooldown. Equal values give uniform pacing:
# every message from a monitor arrives at least that many seconds after its previous one.
ALARM_COOLDOWN_SECONDS=120
ALARM_REPEAT_SECONDS=1800   # 0 disables reminders

# Dashboard live-region poll interval (seconds)
UI_REFRESH_SECONDS=30

# Consecutive sweep failures before the "monitoring degraded" telegram alert
DEGRADED_AFTER_FAILURES=5

# Delay before the single automatic retry of a failed scheduled run
RETRY_DELAY_SECONDS=300

# URL prefix when serving behind a path-stripping reverse proxy, e.g. tailscale serve --set-path /api
# Leave empty for direct access. Note: with this set, open /docs via the proxy URL, not localhost.
ROOT_PATH=

# Timezone for all displayed timestamps (DB records shown in API/bot, plus market update_time,
# which moomoo delivers in US Eastern). Empty = host timezone. Storage stays UTC either way.
DISPLAY_TZ=

# Where the service reaches OpenD:
#   - running natively via launchd/make serve: leave unset (defaults to 127.0.0.1) or set 127.0.0.1
#   - api in Docker, OpenD on the host: host.docker.internal
#   - both in Docker (Linux, --profile opend-docker): opend
OPEND_HOST=host.docker.internal
OPEND_PORT=11111
