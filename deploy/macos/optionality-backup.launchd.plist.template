<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The nightly backup (backend/tools/backup/nightly.ts): a checked, gzipped online copy of the
         live database into __BACKUP_DIR__, pruned to 14 nights and 12 monthly, and then the logs'
         rotation. Not a service: it runs once a night and exits. Installed by `make launchd-backup-install`, which is also how
         the destination changes — re-run it with BACKUP_DIR=... -->
    <key>Label</key>
    <string>com.optionality.backup</string>
    <!-- Then the agents' logs are rotated (tools/rotate-logs.mjs, `make rotate-logs`), whether or
         not the backup succeeded, and the job exits with the BACKUP's status. Through sh so one
         agent does both; the paths arrive as arguments ($0, $1, $2), never spliced into the script,
         because BACKUP_DIR is in iCloud Drive and "Mobile Documents" has a space in it. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>"$0" backend/tools/backup/nightly.ts data/optionality-ts.db "$1"; status=$?; "$0" tools/rotate-logs.mjs "$2"; exit $status</string>
        <string>__NODE__</string>
        <string>__BACKUP_DIR__</string>
        <string>__HOME__/Library/Logs</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <!-- 06:00 here, after the US close in either half of the year, so the day's sample is in it.
         A night the machine sleeps through runs on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/optionality-backup.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/optionality-backup.log</string>
</dict>
</plist>
