<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The service, in whichever language runs it (ADR 0021). ONE label for both backends, so
         exactly one is ever loaded: `make use BACKEND=ts|python` renders this file for the chosen
         one, boots the other out and this in. Rendered by tools/use-backend.mjs, never by hand. -->
    <key>Label</key>
    <string>com.optionality.api</string>
    <!-- Either backend runs from the working tree, so what is checked out is what runs.
           ts      node, which runs the TypeScript source directly (ADR 0009); --env-file loads .env.
           python  the interpreter of the repository's uv environment, by its absolute path because
                   launchd's PATH is minimal; the same --env-file=.env, which the Python reads as
                   Node does, before anything else (env.py). -->
    <key>ProgramArguments</key>
    <array>
__PROGRAM_ARGUMENTS__
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <!-- The same for both: these are what make the two interchangeable, and each beats whatever
         .env says. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- the port the tailscale serve table points at. Each backend takes it FIRST and stops if
             it cannot: it is the lock between the two (ADR 0021, Decision 3) -->
        <key>PORT</key>
        <string>31415</string>
        <!-- ONE database for both backends, migrated by whichever starts first after a change:
             a standby never has a file of its own to fall back to (ADR 0021) -->
        <key>OPTIONALITY_DB_PATH</key>
        <string>data/optionality-ts.db</string>
        <!-- the bot token allows ONE getUpdates consumer, so this is only ever set on the service
             that is actually running — whichever backend this label runs (CLAUDE.md) -->
        <key>OPTIONALITY_BOT</key>
        <string>1</string>
__BACKEND_ENVIRONMENT__
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/optionality-api.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/optionality-api.log</string>
</dict>
</plist>
