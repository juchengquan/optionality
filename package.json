{
  "name": "optionality-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "typescript",
    "backend",
    "frontend"
  ],
  "scripts": {
    "test": "bun run --workspaces --if-present test",
    "test:browser": "bun run --cwd frontend test:browser",
    "typecheck": "bun run --workspaces --if-present typecheck && tsc --noEmit -p tools/tsconfig.json",
    "build": "bun run --cwd frontend build"
  },
  "devDependencies": {
    "@vitest/browser": "^3.2.7",
    "jsdom": "^27.4.0",
    "playwright": "^1.63.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.7",
    "zod": "4.6.5"
  }
}
